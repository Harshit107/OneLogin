# OneLogin API Environment Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URL=mongodb://localhost:27017/onelogin
MONGO_URL_PROD=mongodb+srv://<username>:<password>@cluster.mongodb.net/onelogin?retryWrites=true&w=majority

# Security Secrets
JWT=your_super_secret_jwt_key
ADMIN_SECRET=super_secret_admin_key

# Frontend Host (CORS & Redirects)
FRONTEND_URL=https://account.harshit107.online
